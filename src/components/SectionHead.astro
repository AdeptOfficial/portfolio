---
interface Props {
  n: string;
  name: string;
  headline: string;
}
const { n, name, headline } = Astro.props;
---

<div class="border-t border-line pt-6">
  <p class="overline">Section {n} // {name}</p>
  <h2 class="mt-3 font-display text-3xl font-bold uppercase tracking-tight sm:text-4xl">{headline}</h2>
</div>

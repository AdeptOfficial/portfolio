---
interface Props {
  /** The shell command typed out in the section's prompt line. */
  cmd: string;
  headline: string;
}
const { cmd, headline } = Astro.props;
---

<div class="border-t border-line pt-6">
  <p class="overline">
    <span class="text-faint">adept@lab:~$</span>
    <span data-type={cmd}>{cmd}</span><span class="cursor" aria-hidden="true">▋</span>
  </p>
  <h2 data-decode class="mt-3 font-display text-3xl font-bold uppercase tracking-tight sm:text-4xl">
    {headline}
  </h2>
</div>

---
import { i18n, englishPath, hasTranslation, prefix } from '../lib/i18n';
const { locale } = i18n(Astro.url);
const path = englishPath(Astro.url.pathname);
const equivalent = hasTranslation(path);
const fallback = path.startsWith('/blog/') ? '/blog/' : path.includes('dev-notes') ? '/dev-notes/' : '/';
const chinese = prefix + (equivalent ? path : fallback);
---
<details class="language-switch">
  <summary aria-label="Language / 语言" title="Language / 语言">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18M5 6h14M5 18h14" />
    </svg>
    <span class="sr-only">Language / 语言</span>
  </summary>
  <nav class="language-options" aria-label="Language / 语言">
    <a href={path} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined} data-language-link>English</a>
    <a href={chinese} lang="zh-Hans" hreflang="zh-Hans" aria-current={locale === 'zh-Hans' ? 'true' : undefined} data-language-link={equivalent ? '' : undefined}>简体中文{!equivalent && <span class="sr-only">（返回中文列表或首页）</span>}</a>
  </nav>
</details>
<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('details.language-switch')) {
    for (const link of menu.querySelectorAll<HTMLAnchorElement>('[data-language-link]')) {
      link.addEventListener('click', () => { link.hash = window.location.hash; });
    }
    menu.addEventListener('keydown', (event) => {
      if(event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
    });
    document.addEventListener('click', (event) => {
      if(!menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>

---
import { i18n } from '../lib/i18n';
const { t, localize, locale } = i18n(Astro.url);
import Base from '../layouts/Base.astro';

---

<Base title={t("Not found — adept.dev")}>
  <section class="mx-auto max-w-5xl pt-32">
    <p class="overline" style="color: var(--color-signal);">{t("// Error")}</p>
    <h1 class="mt-5 font-display text-7xl font-bold uppercase tracking-tight">404</h1>
    <p class="mt-5 max-w-md text-muted">{t("Nothing here.")}</p>
    <a
      href={localize("/")}
      class="mt-8 inline-block border border-line px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted transition-colors hover:border-muted hover:text-ink"
    > {t("Back home")} </a>
  <p class="mt-4 text-muted" lang="zh-Hans">页面不存在。<a class="underline" href="/zh-hans/">返回中文首页 →</a></p>
  </section>
</Base>

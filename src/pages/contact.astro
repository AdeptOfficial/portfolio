---
import Base from '../layouts/Base.astro';

export const prerender = true;
---

<Base title="Contact — adept.dev">
  <section class="mx-auto max-w-2xl pt-14">
    <div class="border-t border-line pt-6">
      <p class="overline">Comms</p>
      <h1 class="mt-3 font-display text-4xl font-bold uppercase tracking-tight">Contact</h1>
      <p class="mt-4 leading-relaxed text-muted">
        If you have any questions or just want to get in touch, feel free to reach out.
      </p>
    </div>

    <div class="mt-8 grid gap-px sm:grid-cols-2">
      <a
        href="https://github.com/AdeptOfficial"
        target="_blank"
        rel="noreferrer"
        class="border border-line bg-card p-5 transition-colors hover:border-muted hover:bg-card-hover"
      >
        <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-faint">GitHub</p>
        <p class="mt-1 font-display font-bold">AdeptOfficial</p>
      </a>
      <a
        href="mailto:hello@adeptproductions.dev"
        class="border border-line bg-card p-5 transition-colors hover:border-muted hover:bg-card-hover"
      >
        <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-faint">Email</p>
        <p class="mt-1 font-display font-bold">hello@adeptproductions.dev</p>
      </a>
    </div>
  </section>
</Base>

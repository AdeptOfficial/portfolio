---
import Base from '../layouts/Base.astro';
import DiscordAvatar from '../components/DiscordAvatar';
import NowPlaying from '../components/NowPlaying';
import Projects from '../components/Projects';

export const prerender = true;
---

<Base title="AdepT — Design. Code. Ship. Repeat.">
  <!-- Hero -->
  <section class="mx-auto grid max-w-5xl items-center gap-10 pt-16 sm:pt-24 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="overline" style="color: var(--color-signal);">// Hey, I'm AdepT</p>
      <h1 class="mt-5 font-display text-5xl font-bold uppercase leading-[0.95] tracking-tight sm:text-7xl">
        Certified<br /><span class="text-muted">Vibe Coder</span>
      </h1>
      <p class="mt-6 max-w-md text-xl leading-relaxed text-ink/90">Design. Code. Ship. Repeat.</p>
      <p class="mt-4 max-w-md leading-relaxed text-muted">
        Computer science student driven by the belief that there's always a challenge greater than the
        one you're currently facing — so why be afraid now?
      </p>
    </div>
    <div class="flex flex-col items-center gap-6 lg:col-span-5">
      <DiscordAvatar client:load />
      <div class="w-full max-w-xs">
        <NowPlaying client:load />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="mx-auto max-w-5xl scroll-mt-24 pt-20">
    <div class="border-t border-line pt-6">
      <p class="overline">01 / GitHub</p>
      <h2 class="mt-3 font-display text-3xl font-bold uppercase tracking-wide">Projects</h2>
    </div>
    <div class="mt-8">
      <Projects client:visible />
    </div>
  </section>
</Base>

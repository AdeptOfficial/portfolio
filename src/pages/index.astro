---
import { i18n } from '../lib/i18n';
const { t, localize, locale } = i18n(Astro.url);
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import DiscordAvatar from '../components/DiscordAvatar';
import NowPlaying from '../components/NowPlaying';


// Screenshot slots activate when files land in public/projects/<slug>.png.
const shot = (slug: string) => (fs.existsSync(`public/projects/${slug}.png`) ? `/projects/${slug}.png` : null);

// Hand-picked project list — the source of truth for what's public. Never
// auto-list private repos. `href: null` renders as "Private" (no link).
// Operational + In development render as cards; Dormant + Decommissioned as rows.
type Project = {
  slug: string;
  name: string;
  /** Card rank within the suit; '★' = the Joker. */
  rank: string;
  status: 'OPERATIONAL' | 'IN DEVELOPMENT' | 'DORMANT' | 'DECOMMISSIONED';
  blurb: string;
  tags: string[];
  href: string | null;
  linkLabel?: string;
};

const PROJECTS: Project[] = [
  // ── Operational ──
  {
    slug: 'adeptlab',
    name: 'AdepTLab',
    rank: 'A',
    status: 'OPERATIONAL',
    blurb:
      t("My homelab: two Proxmox servers running 20+ services (media, photos, AI inference, automation) with GPU passthrough, a three-layer no-cloud backup strategy, and firewalled public services behind Cloudflare Tunnels."),
    tags: ['proxmox', 'docker', 'zfs', 'tailscale', 'cloudflare'],
    href: null,
  },
  {
    slug: 'studio',
    name: 'adeptproductions.dev',
    rank: 'K',
    status: 'OPERATIONAL',
    blurb:
      t("The studio itself: app catalogue, dev notes, and blog. Astro static build served from my own hardware behind a Cloudflare Tunnel, firewalled both directions."),
    tags: ['astro', 'tailwind', 'docker', 'self-hosted'],
    href: 'https://adeptproductions.dev',
    linkLabel: 'Visit',
  },
  {
    slug: 'status-tracker',
    name: 'Status Tracker',
    rank: 'Q',
    status: 'OPERATIONAL',
    blurb: t("Follows a media request through a self-hosted pipeline, from requested to watchable, and shows where it is stuck."),
    tags: ['python', 'webhooks', 'self-hosted'],
    href: 'https://github.com/AdeptOfficial/status-tracker',
  },
  {
    slug: 'tracker-bot',
    name: '[REDACTED] Tracker Bot',
    rank: 'J',
    status: 'OPERATIONAL',
    blurb: t("Discord bot built from scratch for a [REDACTED] community server: member verification, a recruiter queue, and course records."),
    tags: ['discord.js', 'mongodb'],
    href: null,
  },
  // ── In development ──
  {
    slug: 'dayplan',
    name: 'dayplan',
    rank: 'A',
    status: 'IN DEVELOPMENT',
    blurb:
      t("AI-assisted day planner: describe your week in plain language and it proposes tasks, events, and time blocks. Review, apply atomically, undo as a group."),
    tags: ['react', 'sqlite', 'ai-assistant', 'self-hosted'],
    href: 'https://adeptproductions.dev/apps/dayplan/',
    linkLabel: 'Studio',
  },
  {
    slug: 'nullias',
    name: 'NULLIAS',
    rank: 'K',
    status: 'IN DEVELOPMENT',
    blurb:
      t("Chat that's dead to their systems. Coming soon."),
    tags: ['bun', 'privacy'],
    href: 'https://adeptproductions.dev/apps/nullias/',
    linkLabel: 'Studio',
  },
  {
    slug: 'ditto-looper',
    name: 'Ditto Looper',
    rank: 'Q',
    status: 'IN DEVELOPMENT',
    blurb: t("Real-time Android audio looper modeled on a guitar pedal: layer stacking, overdubs, hold-to-undo, built on low-latency native audio."),
    tags: ['kotlin', 'android', 'oboe'],
    href: 'https://github.com/AdeptOfficial/record',
  },
  {
    slug: 'domain-watcher',
    name: 'Domain Watcher',
    rank: 'J',
    status: 'IN DEVELOPMENT',
    blurb: t("Daily RDAP checks on domains I want or own. Alerts the day a drop is coming, so I never lose another one by six days."),
    tags: ['rdap', 'n8n', 'self-hosted'],
    href: null,
  },
  {
    slug: 'vllm',
    name: 'vLLM on an RTX 5090',
    rank: '10',
    status: 'IN DEVELOPMENT',
    blurb: t("Running, serving, and benchmarking LLMs locally on a daily-driver Arch machine without breaking system Python, CUDA, or drivers."),
    tags: ['vllm', 'cuda', 'benchmarks'],
    href: 'https://github.com/AdeptOfficial/vLLM-test',
  },
  {
    slug: 'watch-together',
    name: 'Watch Together',
    rank: '9',
    status: 'IN DEVELOPMENT',
    blurb:
      t("Self-hosted watch-together for my Jellyfin: synced playback so friends can watch the same thing from anywhere in the world — including behind the Great Firewall."),
    tags: ['jellyfin', 'sync', 'self-hosted'],
    href: null,
  },
  // ── Dormant ──
  {
    slug: 'syna',
    name: 'Syna',
    rank: '★',
    status: 'DORMANT',
    blurb: t("Training an AI model into an entertainment-focused persona built to engage and interact with audiences."),
    tags: ['python', 'llm'],
    href: 'https://github.com/AdeptOfficial/Syna',
  },
  // ── Decommissioned ──
  {
    slug: 'devhub',
    name: 'DevHub',
    rank: 'A',
    status: 'DECOMMISSIONED',
    blurb:
      t("Collab project with a friend: a hub for finding projects to contribute to and people to build with, with video calling, real-time chat, and a meetup location finder."),
    tags: ['django', 'channels', 'celery', 'redis', 'docker'],
    href: null,
  },
  {
    slug: 'adept-dev-mark-1',
    name: 'adept.dev — Mark 1',
    rank: 'K',
    status: 'DECOMMISSIONED',
    blurb: t("The previous incarnation of this site: Next.js 14, NextAuth, Vercel. Retired by Mark 2, the one you're reading."),
    tags: ['nextjs', 'vercel'],
    href: null,
  },
];

// Project lifecycle: one vocabulary, one color per stage (all sampled from the brand art).
// Suits map to stages — four suits, four stages, colors from the brand art.
const STAGES = [
  { key: 'OPERATIONAL', suit: '♠', color: 'var(--color-signal)', note: t("shipped & running"), layout: 'cards' },
  { key: 'IN DEVELOPMENT', suit: '♥', color: 'var(--color-matrix)', note: t("actively being built"), layout: 'cards' },
  { key: 'DORMANT', suit: '♦', color: 'var(--color-scarf)', note: t("face-down, may re-enter the deck"), layout: 'rows' },
  { key: 'DECOMMISSIONED', suit: '♣', color: 'var(--color-crimson)', note: t("the discard pile"), layout: 'rows' },
] as const;

// Render [REDACTED] tokens inside text as styled redaction bars.
const redactParts = (text: string) => text.split(/(\[REDACTED\])/);

// The machines — fastfetch-style. No serials, nothing identifying.
const RIGS = [
  {
    host: 'syna',
    title: t("The battlestation"),
    rows: [
      ['OS', 'SynaOS (CachyOS base) · Linux · Hyprland'],
      ['Board', 'X870E AORUS ELITE WIFI7 ICE'],
      ['CPU', 'AMD Ryzen 9 9950X3D (32) @ 5.76 GHz'],
      ['GPU', 'NVIDIA RTX 5090 (+ GTX 1080 → VMs)'],
      ['Memory', '64 GiB DDR5'],
      ['Displays', '27" 1440p @ 280 Hz · 24" 1080p @ 165 Hz'],
      ['Packages', '~1,950 (pacman) + flatpaks'],
      ['Terminal', 'Ghostty'],
      ['Font', 'JetBrains Mono'],
      ['Theme', 'Akane', 'palette'],
    ],
  },
  {
    host: 'adeptlab',
    title: t("The server room"),
    rows: [
      ['Hypervisor', 'Proxmox VE — 20+ LXCs & VMs'],
      ['Board', 'MSI MPG B850I EDGE TI WIFI'],
      ['CPU', 'AMD Ryzen 9 9950X3D (prod node)'],
      ['GPU', 'NVIDIA RTX 5070 Ti (AI + transcode)'],
      ['Memory', '64 GiB DDR5'],
      ['Storage', '2×20 TB ZFS mirror + NVMe + DAS'],
      ['Sidekick', 'Beelink SER5 MAX (dev node)'],
      ['Network', 'Cloudflare Tunnel + Tailscale'],
      ['Stack', 'Media · Photos · Files · AI · Games'],
      ['Studio', 'adeptproductions.dev + me.'],
    ],
  },
];

// fastfetch-style terminal palette strip (the Akane scheme, in brand colors)
const PALETTE = [
  'var(--color-surface)',
  'var(--color-crimson)',
  'var(--color-matrix)',
  'var(--color-scarf)',
  'var(--color-signal)',
  'var(--color-magenta)',
  'var(--color-ice)',
  'var(--color-ink)',
];

// Label -> Nerd Font icon (same glyphs as the user's fastfetch config where one exists).
const NF: Record<string, string> = {
  OS: '\u{F303}',
  Board: '\u{F109}',
  CPU: '\u{F4BC}',
  GPU: '\u{E266}',
  Memory: '\u{EFC5}',
  Displays: '\u{F1104}',
  Packages: '\u{F03D6}',
  Terminal: '\u{F489}',
  Font: '\u{F031}',
  Theme: '\u{F0E0C}',
  Hypervisor: '\u{F048B}',
  Storage: '\u{F02CA}',
  Backups: '\u{F006F}',
  Sidekick: '\u{F109}',
  Network: '\u{F0317}',
  Stack: '\u{F0328}',
  Studio: '\u{F0674}',
};

const EXPERIENCE = [
  {
    period: t("2026 — PRESENT"),
    role: t("Software Developer · Enterprise API"),
    org: '[REDACTED]',
    points: [
      t("Build and maintain MuleSoft applications powering integrations for product teams across the enterprise"),
      t("MuleSoft Community of Practice — the dev other devs ping when the integration layer fights back"),
      t("Maintainer of Enterprise API Automation: PR-review automation, Jenkins + UrbanCode deploy rails, CLI tooling used daily by internal teams"),
    ],
  },
  {
    period: t("SIDE QUESTS"),
    role: t("Intrapreneur · Internal Apps"),
    org: '[REDACTED]',
    points: [
      t("Check-In — in-person work tracker adopted by other departments (successfully automated myself out of the office)"),
      t("Evidence Builder — AI captures your wins daily, so review season becomes copy-paste into Workday instead of archaeology"),
    ],
  },
  {
    period: '2024 — 2026',
    role: t("Software Developer"),
    org: '[REDACTED]',
    points: [
      t("Enterprise integration flows moving data between internal systems and product teams — transformation, validation, 100% automated test coverage"),
      t("Capacity dashboards for monitoring server usage and forecasting demand"),
    ],
  },
  {
    period: '2023',
    role: t("Software Developer Intern"),
    org: '[REDACTED]',
    points: [t("RPA automation initiatives — internal storage and caching upkeep inside a virtual desktop environment")],
  },
  {
    period: '2022',
    role: t("Software Developer Intern"),
    org: '[REDACTED]',
    points: [
      t("Legacy Java framework migration — eliminating technical debt"),
      t("Devcontainer-based test development to cut onboarding time for future developers"),
    ],
  },
  {
    period: '2020 — 2023',
    role: t("Founder & President"),
    org: 'Trackers @ [REDACTED]',
    points: [
      t("Built a central hub for CS students — grown to 2,000+ members, with workshops and networking events through every academic year"),
    ],
  },
];

const CAPABILITIES = [
  {
    title: t("Full-stack engineering"),
    body: t("TypeScript, React, Astro & Tailwind up front; Java, Python/Django & MuleSoft behind; Postgres, SQLite & Mongo underneath. Pipelines ship with tests."),
  },
  {
    title: t("Self-hosted infrastructure"),
    body: t("Proxmox, Docker, ZFS, Cloudflare Tunnels — everything you're reading is served from hardware I run."),
  },
  {
    title: t("Automation & tooling"),
    body: t("n8n, RPA, Jenkins & UCD pipelines, internal CLI tools — if it happens twice, it gets automated."),
  },
  {
    title: t("Community & leadership"),
    body: t("Founded a 2,000-member CS community; the dev other devs ask first. Teaching is half the fun."),
  },
];
---

<Base title={t("AdepT — Design. Code. Ship. Repeat.")}>
  <!-- Hero — decode sequence -->
  <section
    class="mx-auto grid min-h-[calc(100svh-4rem)] max-w-5xl content-center items-center gap-10 py-12 lg:grid-cols-12"
  >
    <div class="lg:col-span-7">
      <p class="overline">
        <span class="text-faint">adept@lab:~$</span>
        <span data-type="./init --dossier">./init --dossier</span><span class="cursor" aria-hidden="true">▋</span>
      </p>
      <h1 class="mt-5 font-display text-5xl font-bold uppercase leading-[0.95] tracking-tight sm:text-7xl">
        <span data-decode>{t("Hi there,")}</span><br />
        <span data-decode class="text-muted">{t("I'm AdepT.")}</span>
      </h1>
      <p class="rv mt-6 max-w-md text-xl leading-relaxed text-ink/90" style="--d: 0.45s;"> {t("Software developer at")} <span class="redact">[REDACTED]</span> {t("& founder of")} <a href={localize("https://adeptproductions.dev")} class="underline decoration-faint underline-offset-4 hover:decoration-ink">Adept Productions</a>.
      </p>
      <p class="rv mt-4 max-w-md leading-relaxed text-muted" style="--d: 0.6s;"> {t("I build small, focused software — and self-host everything I can get away with.")} </p>
    </div>
    <div class="rv flex flex-col items-center gap-6 lg:col-span-5" style="--d: 0.75s;">
      <DiscordAvatar locale={locale} client:load />
      <div class="w-full max-w-xs">
        <NowPlaying locale={locale} client:load />
      </div>
    </div>
  </section>

  <!-- 1.0 ABOUT — slides in from the left, like a file opening -->
  <section
    id="about"
    class="mx-auto flex min-h-[calc(100svh-4rem)] max-w-5xl scroll-mt-16 flex-col justify-center py-12"
  >
    <div class="rv-left">
      <SectionHead cmd="cat sections/1.0_about.md" headline={t("Why be afraid now?")} />
    </div>
    <div class="rv-left mt-6 max-w-2xl space-y-4 leading-relaxed text-muted" style="--d: 0.2s;">
      <p> {t("I'm driven by a simple belief:")} <strong class="text-ink">{t("there's always a challenge greater than the one you're currently facing — so why be afraid now?")}</strong> {t("That's carried me from running a 2,000-member computer science community to shipping enterprise integrations by day and building an independent software studio by night.")} </p>
      <details class="decrypt">
        <summary
          class="cursor-pointer font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-faint transition-colors hover:text-ink"
        >
          <span class="when-closed">▸ sudo decrypt about.full.enc {locale === "zh-Hans" && "（展开）"}</span>
          <span class="when-open">{t("▾ // decrypted — clearance granted")}</span>
        </summary>
        <div class="expand mt-4 space-y-4 border-l border-line pl-5">
          <p> {t("I'm an entrepreneur at heart. Every community I'm part of has pain points hiding in plain sight — and I can't")} <em>{t("not")}</em> {t("build the fix. That instinct became a 2,000-member hub for CS students who needed a place to land, co-founded ventures in consumer tech and campus food access (names")} <span class="redact">[REDACTED]</span>{t("), and internal tools my coworkers now use every day — including one that automated my own desk out of the office.")} </p>
          <p>
            <a href={localize("https://adeptproductions.dev")} class="text-ink underline decoration-faint underline-offset-4 hover:decoration-ink">Adept Productions</a> {t("is that same instinct, aimed outward: focused tools for real problems, honest dev notes on every app, and educational tech media. Everything runs on hardware I manage myself, from the hypervisor up — because the homelab community has pain points too.")} </p>
        </div>
      </details>
    </div>
  </section>

  <!-- 2.0 EXPERIENCE — log replaying: rows cascade in -->
  <section
    id="experience"
    class="mx-auto flex min-h-[calc(100svh-4rem)] max-w-5xl scroll-mt-16 flex-col justify-center py-12"
  >
    <div class="rv">
      <SectionHead cmd="less sections/2.0_experience.log" headline={t("Trial by production")} />
    </div>

    <!-- No stagger here: each row triggers on its own scroll entry, so the
         cascade follows the reader down the tall section. -->
    <div class="mt-8 space-y-px">
      {
        EXPERIENCE.map((job) => (
          <div class="rv grid gap-2 border border-line bg-card p-5 sm:grid-cols-12 sm:gap-6">
            <p class="font-mono text-[11px] font-bold tracking-[0.2em] text-faint sm:col-span-3">{job.period}</p>
            <div class="sm:col-span-9">
              <h3 class="font-display text-lg font-bold">
                {job.role} <span class="text-faint">//</span> <span class="redact">{job.org}</span>
              </h3>
              <ul class="mt-2 space-y-1 text-sm leading-relaxed text-muted">
                {job.points.map((pt) => (
                  <li class="flex gap-2">
                    <span class="text-faint" aria-hidden="true">
                      —
                    </span>
                    {pt}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
      <div class="rv grid gap-2 border border-line bg-card p-5 sm:grid-cols-12 sm:gap-6">
        <p class="font-mono text-[11px] font-bold tracking-[0.2em] sm:col-span-3" style="color: var(--color-signal);"> {t("INCOMING 2027")} </p>
        <div class="sm:col-span-9">
          <h3 class="font-display text-lg font-bold"> {t("M.S., Computer Science")} <span class="text-faint">//</span>
            <span class="redact">[REDACTED] — ONLINE</span>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{t("Leveling up while shipping. Starts January 2027.")}</p>
        </div>
      </div>
      <div class="rv grid gap-2 border border-line bg-card p-5 sm:grid-cols-12 sm:gap-6">
        <p class="font-mono text-[11px] font-bold tracking-[0.2em] text-faint sm:col-span-3">{t("DEC 2023")}</p>
        <div class="sm:col-span-9">
          <h3 class="font-display text-lg font-bold"> {t("Honours B.S., Computer Science")} <span class="text-faint">//</span>
            <span class="redact">[REDACTED] UNIVERSITY</span>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted"> {t("Minor in entrepreneurship. Major GPA 3.7/4.0. The rest is classified.")} </p>
        </div>
      </div>
    </div>

    <div class="stagger mt-8 grid gap-px sm:grid-cols-2">
      {
        CAPABILITIES.map((cap) => (
          <div class="rv-scale border border-line bg-card p-5">
            <h3 class="font-display font-bold">{cap.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{cap.body}</p>
          </div>
        ))
      }
    </div>

    <a
      href="mailto:hello@adeptproductions.dev?subject=Resume%20request"
      class="rv mt-8 inline-block self-start border border-line px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted transition-colors hover:border-signal hover:text-ink"
      style="--d: 0.7s;"
    > {t("Request the full dossier →")} </a>
  </section>

  <!-- 3.0 SYSTEM — fastfetch, as a webpage -->
  <section
    id="system"
    class="mx-auto flex min-h-[calc(100svh-4rem)] max-w-5xl scroll-mt-16 flex-col justify-center py-12"
  >
    <div class="rv">
      <SectionHead cmd="fastfetch --all-rigs" headline={t("The machines behind it")} />
    </div>
    <div class="stagger mt-8 grid gap-4 md:grid-cols-2">
      {
        RIGS.map((rig) => (
          <div class="rv-scale overflow-hidden border border-line bg-card">
            <div class="flex items-center gap-2 border-b border-line bg-surface px-4 py-2.5 font-mono text-[11px] tracking-[0.15em]">
              <span class="flex gap-1.5" aria-hidden="true">
                <span class="size-2.5 rounded-full border border-line" />
                <span class="size-2.5 rounded-full border border-line" />
                <span class="size-2.5 rounded-full" style="background: var(--color-signal);" />
              </span>
              <span class="text-muted">
                adept@<span style="color: var(--color-signal);">{rig.host}</span>{t(":~$ fastfetch")} </span>
            </div>
            <div class="p-5">
              <div class="grid grid-cols-[1.4rem_1fr] text-sm leading-6">
                <span class="tree-tick first" aria-hidden="true" />
                <p class="font-mono font-bold">{rig.title}</p>
              </div>
              <dl>
                {rig.rows.map(([k, v, kind], i) => (
                  <div class="grid grid-cols-[1.4rem_8.5rem_1fr] gap-x-1 text-sm leading-6">
                    <span class={`tree-tick${i === rig.rows.length - 1 ? ' last' : ''}`} aria-hidden="true" />
                    <dt class="whitespace-nowrap font-mono text-[11px] uppercase leading-6 tracking-[0.15em]" style="color: var(--color-signal);">
                      <span class="nf mr-1.5 text-[13px] normal-case tracking-normal" aria-hidden="true">{NF[k] ?? ''}</span>{t(k)}:
                    </dt>
                    <dd class="leading-6 text-muted">
                      {kind === 'palette' ? (
                        <span class="inline-flex items-center gap-1.5">
                          {v}
                          <span class="inline-flex gap-1" aria-label={t("color scheme")}>
                            {PALETTE.map((c) => (
                              <span class="size-2.5 rounded-full border border-line" style={`background: ${c};`} />
                            ))}
                          </span>
                        </span>
                      ) : (
                        v
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 4.0 PROJECTS — grouped by lifecycle stage: live work as cards, the rest as rows -->
  <section
    id="projects"
    class="mx-auto flex min-h-[calc(100svh-4rem)] max-w-5xl scroll-mt-16 flex-col justify-center py-12"
  >
    <div class="rv">
      <SectionHead cmd="deal sections/4.0_projects.deck" headline={t("The hand I'm playing")} />
    </div>

    {
      STAGES.map((stage) => {
        const items = PROJECTS.filter((p) => p.status === stage.key);
        if (items.length === 0) return null;
        return (
          <div class="mt-10">
            <h3 class="rv flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] uppercase tracking-[0.25em]">
              <span class="text-sm font-bold" style={`color: ${stage.color};`} aria-hidden="true">{stage.suit}</span>
              <span class="font-bold" style={`color: ${stage.color};`}>{t(stage.key)}</span>
              <span class="text-faint">[{items.length}] // {stage.note}</span>
            </h3>

            {stage.layout === 'cards' ? (
              <div class="stagger mt-4 grid gap-4 md:grid-cols-2">
                {items.map((p) => {
                  const Card = p.href ? 'a' : 'div';
                  const image = shot(p.slug);
                  return (
                    <Card
                      href={localize(p.href ?? undefined)}
                      target={p.href?.startsWith('http') && !p.href.includes('adeptproductions.dev') ? '_blank' : undefined}
                      rel={p.href ? 'noreferrer' : undefined}
                      class="rv-scale group block"
                    >
                    <div
                      class="card-tilt relative flex h-full flex-col overflow-hidden border border-line transition-colors group-hover:border-muted"
                      style={`border-top: 2px solid ${stage.color};
                        background: radial-gradient(32rem at top right, color-mix(in srgb, ${stage.color} 7%, var(--color-card)), var(--color-card));`}
                    >
                      <span class="card-index left-2 top-1.5" style={`color: ${stage.color};`} aria-hidden="true">
                        {p.rank}
                        <br />
                        {p.rank === '★' ? '' : stage.suit}
                      </span>
                      <span class="card-index bottom-1.5 right-2 rotate-180" style={`color: ${stage.color};`} aria-hidden="true">
                        {p.rank}
                        <br />
                        {p.rank === '★' ? '' : stage.suit}
                      </span>
                      {image && <img src={image} alt={`${p.name} ${t("screenshot")}`} class="aspect-video w-full border-b border-line object-cover" />}
                      <span
                        class="pointer-events-none absolute -right-1 -top-7 select-none font-display text-[7rem] font-bold leading-none opacity-[0.07]"
                        style={`color: ${stage.color};`}
                        aria-hidden="true"
                      >
                        {p.rank === '★' ? '★' : stage.suit}
                      </span>
                      <div class="relative flex flex-1 flex-col p-5 pl-9 pr-8">
                        <div class="flex items-start justify-between gap-3">
                          <h4 class="font-display text-lg font-bold">
                            {redactParts(p.name).map((part) =>
                              part === '[REDACTED]' ? <span class="redact">[REDACTED]</span> : part
                            )}
                          </h4>
                          <span
                            class="shrink-0 font-mono text-[11px] uppercase tracking-[0.15em]"
                            style={`color: ${p.href ? stage.color : 'var(--color-faint)'};`}
                          >
                            {p.href ? `${t(p.linkLabel ?? 'GitHub')} ↗` : t('Private')}
                          </span>
                        </div>
                        <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">
                          {redactParts(p.blurb).map((part) =>
                            part === '[REDACTED]' ? <span class="redact">[REDACTED]</span> : part
                          )}
                        </p>
                        <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
                          {p.tags.map((t) => (
                            <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-faint">#{t}</span>
                          ))}
                        </div>
                      </div>
                    </div>
                    </Card>
                  );
                })}
              </div>
            ) : (
              <div class="mt-4 grid gap-px">
                {items.map((p) => (
                  <div
                    class="rv grid gap-3 border border-line bg-card px-5 py-4 transition-colors hover:border-muted sm:grid-cols-[1fr_auto] sm:items-center"
                    style={`border-left: 2px solid ${stage.color};`}
                  >
                    <div class="min-w-0">
                      <h4 class="font-display font-bold">
                        <span class="mr-2 font-mono text-sm" style={`color: ${stage.color};`}>
                          {p.rank === '★' ? '★ JOKER' : p.rank + stage.suit}
                        </span>
                        {p.name}
                      </h4>
                      <p class="mt-1 text-sm leading-relaxed text-muted">{p.blurb}</p>
                      <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
                        {p.tags.map((t) => (
                          <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-faint">#{t}</span>
                        ))}
                      </div>
                    </div>
                    {p.href ? (
                      <a
                        href={localize(p.href)}
                        target="_blank"
                        rel="noreferrer"
                        class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted hover:text-ink"
                      >
                        {t(p.linkLabel ?? 'GitHub')} ↗
                      </a>
                    ) : (
                      <span class="font-mono text-[11px] uppercase tracking-[0.15em] text-faint">{t("Private")}</span>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        );
      })
    }
  </section>

  <!-- 5.0 CONTACT — signal locking on: blur to sharp -->
  <section
    id="contact"
    class="mx-auto flex min-h-[calc(100svh-4rem)] max-w-5xl scroll-mt-16 flex-col justify-center py-12"
  >
    <div class="rv-blur">
      <SectionHead cmd="./open_channel.sh --secure" headline={t("Open a channel")} />
    </div>
    <p class="rv-blur mt-6 max-w-xl leading-relaxed text-muted" style="--d: 0.2s;"> {t("Questions, collaborations, or just want to compare homelab notes — the inbox is open.")} </p>
    <div class="rv-blur mt-8 flex flex-wrap gap-3" style="--d: 0.35s;">
      <a
        href="mailto:hello@adeptproductions.dev"
        class="border border-ink bg-ink px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.2em] transition-colors hover:border-signal hover:bg-signal"
        style="color: var(--color-base);"
      >
        hello@adeptproductions.dev
      </a>
    </div>
  </section>
</Base>

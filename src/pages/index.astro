---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import DiscordAvatar from '../components/DiscordAvatar';
import NowPlaying from '../components/NowPlaying';
import Projects from '../components/Projects';

export const prerender = true;

// Featured tier — screenshot slots activate when files land in public/projects/.
const shot = (slug: string) => (fs.existsSync(`public/projects/${slug}.png`) ? `/projects/${slug}.png` : null);

const FEATURED = [
  {
    serial: '001',
    name: 'dayplan',
    badge: 'WIP',
    badgeColor: 'var(--color-muted)',
    blurb:
      'AI-assisted day planner: describe your week in plain language and it proposes tasks, events, and time blocks — review, apply atomically, undo as a group.',
    tags: ['react', 'sqlite', 'ai-assistant', 'self-hosted'],
    href: 'https://adeptproductions.dev/apps/dayplan/',
    image: shot('dayplan'),
  },
  {
    serial: '002',
    name: 'ConnectHub',
    badge: 'WIP',
    badgeColor: 'var(--color-muted)',
    blurb:
      'Real-time chat platform on Bun — Discord-style spaces and channels with an architecture built from day one for end-to-end encrypted group messaging.',
    tags: ['bun', 'websockets', 'e2ee'],
    href: 'https://adeptproductions.dev/apps/connecthub/',
    image: shot('connecthub'),
  },
  {
    serial: '003',
    name: 'adeptproductions.dev',
    badge: 'LIVE',
    badgeColor: 'var(--color-signal)',
    blurb:
      'The studio itself — app catalogue, dev notes, and blog. Astro static build served from my own hardware behind a Cloudflare Tunnel, firewalled both directions.',
    tags: ['astro', 'tailwind', 'docker', 'self-hosted'],
    href: 'https://adeptproductions.dev',
    image: shot('studio'),
  },
];

const EXPERIENCE = [
  {
    period: '2024 — PRESENT',
    role: 'Software Developer',
    org: '[REDACTED]',
    points: [
      'Enterprise integration flows moving data between internal systems and product teams — transformation, validation, 100% automated test coverage',
      'Capacity dashboards for monitoring server usage and forecasting demand',
    ],
  },
  {
    period: '2023',
    role: 'Software Developer Intern',
    org: '[REDACTED]',
    points: ['RPA automation initiatives — internal storage and caching upkeep inside a virtual desktop environment'],
  },
  {
    period: '2022',
    role: 'Software Developer Intern',
    org: '[REDACTED]',
    points: [
      'Legacy Java framework migration — eliminating technical debt',
      'Devcontainer-based test development to cut onboarding time for future developers',
    ],
  },
  {
    period: '2020 — 2023',
    role: 'Founder & President',
    org: 'Trackers @ [REDACTED]',
    points: [
      'Built a central hub for CS students — grown to 2,000+ members, with workshops and networking events through every academic year',
    ],
  },
];

const CAPABILITIES = [
  { title: 'Backend & integrations', body: 'Java, Python/Django, REST APIs, data pipelines that ship with tests.' },
  { title: 'Self-hosted infrastructure', body: 'Proxmox, Docker, tunnels, DNS — this page is served from hardware I run.' },
  { title: 'Automation', body: 'RPA, n8n workflows, CI — if it happens twice, it gets automated.' },
  { title: 'Community & leadership', body: 'Founded and ran a 2,000-member CS community; teaching is half the fun.' },
];
---

<Base title="AdepT — Design. Code. Ship. Repeat.">
  <!-- Hero -->
  <section class="mx-auto grid max-w-5xl items-center gap-10 pb-20 pt-16 sm:pt-24 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="overline">// Design. Code. Ship. Repeat.</p>
      <h1 class="mt-5 font-display text-5xl font-bold uppercase leading-[0.95] tracking-tight sm:text-7xl">
        Hi there,<br />I'm <span class="text-muted">AdepT</span>.
      </h1>
      <p class="mt-6 max-w-md text-xl leading-relaxed text-ink/90">
        Software developer at <span class="redact">[REDACTED]</span> &amp; founder of
        <a href="https://adeptproductions.dev" class="underline decoration-faint underline-offset-4 hover:decoration-ink">Adept Productions</a>.
      </p>
      <p class="mt-4 max-w-md leading-relaxed text-muted">
        I build small, focused software — and self-host everything I can get away with.
      </p>
    </div>
    <div class="flex flex-col items-center gap-6 lg:col-span-5">
      <DiscordAvatar client:load />
      <div class="w-full max-w-xs">
        <NowPlaying client:load />
      </div>
    </div>
  </section>

  <!-- 1.0 ABOUT -->
  <section id="about" class="mx-auto max-w-5xl scroll-mt-24 pt-10">
    <SectionHead n="1.0" name="About" headline="Why be afraid now?" />
    <div class="mt-6 max-w-2xl space-y-4 leading-relaxed text-muted">
      <p>
        I'm driven by a simple belief: <strong class="text-ink">there's always a challenge greater than the one
        you're currently facing — so why be afraid now?</strong> That's carried me from running a
        2,000-member computer science community to shipping enterprise integrations by day and building an
        independent software studio by night.
      </p>
      <details class="group">
        <summary
          class="cursor-pointer font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-faint transition-colors hover:text-ink"
        >
          Read more +
        </summary>
        <div class="mt-4 space-y-4 border-l border-line pl-5">
          <p>
            Along the way I've co-founded ventures in consumer tech and campus food access — the names are
            <span class="redact">[REDACTED]</span>, but the lesson wasn't: build for the community in front of
            you, and finish what you start.
          </p>
          <p>
            Today that energy goes into <a href="https://adeptproductions.dev" class="text-ink underline decoration-faint underline-offset-4 hover:decoration-ink">Adept Productions</a> —
            focused tools for real problems, honest dev notes on every app, and educational tech media. Everything
            runs on hardware I manage myself, from the hypervisor up.
          </p>
        </div>
      </details>
    </div>
  </section>

  <!-- 2.0 EXPERIENCE -->
  <section id="experience" class="mx-auto max-w-5xl scroll-mt-24 pt-20">
    <SectionHead n="2.0" name="Experience" headline="Trial by production" />

    <div class="mt-8 space-y-px">
      {
        EXPERIENCE.map((job) => (
          <div class="grid gap-2 border border-line bg-card p-5 sm:grid-cols-12 sm:gap-6">
            <p class="font-mono text-[11px] font-bold tracking-[0.2em] text-faint sm:col-span-3">{job.period}</p>
            <div class="sm:col-span-9">
              <h3 class="font-display text-lg font-bold">
                {job.role} <span class="text-faint">//</span> <span class="redact">{job.org}</span>
              </h3>
              <ul class="mt-2 space-y-1 text-sm leading-relaxed text-muted">
                {job.points.map((pt) => (
                  <li class="flex gap-2">
                    <span class="text-faint" aria-hidden="true">
                      —
                    </span>
                    {pt}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
      <div class="grid gap-2 border border-line bg-card p-5 sm:grid-cols-12 sm:gap-6">
        <p class="font-mono text-[11px] font-bold tracking-[0.2em] text-faint sm:col-span-3">DEC 2023</p>
        <div class="sm:col-span-9">
          <h3 class="font-display text-lg font-bold">
            Honours B.S., Computer Science <span class="text-faint">//</span>
            <span class="redact">[REDACTED] UNIVERSITY</span>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Minor in entrepreneurship. The rest is classified.</p>
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-px sm:grid-cols-2">
      {
        CAPABILITIES.map((cap) => (
          <div class="border border-line bg-card p-5">
            <h3 class="font-display font-bold">{cap.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{cap.body}</p>
          </div>
        ))
      }
    </div>

    <a
      href="mailto:hello@adeptproductions.dev?subject=Resume%20request"
      class="mt-8 inline-block border border-ink bg-ink px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.2em] transition-colors hover:border-signal hover:bg-signal"
      style="color: var(--color-base);"
    >
      Request the full dossier →
    </a>
  </section>

  <!-- 3.0 PROJECTS -->
  <section id="projects" class="mx-auto max-w-5xl scroll-mt-24 pt-20">
    <SectionHead n="3.0" name="Projects" headline="Projects make perfect" />

    <!-- Featured tier -->
    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {
        FEATURED.map((p) => (
          <a
            href={p.href}
            class="group flex flex-col border border-line bg-card transition-colors hover:border-muted"
          >
            {p.image ? (
              <img src={p.image} alt={`${p.name} screenshot`} class="aspect-video w-full border-b border-line object-cover" />
            ) : (
              <div
                class="relative flex aspect-video w-full items-end overflow-hidden border-b border-line p-4"
                style="background: radial-gradient(28rem at top right, color-mix(in srgb, var(--color-signal) 12%, var(--color-surface)), var(--color-surface));"
              >
                <span
                  class="pointer-events-none absolute -right-2 -top-8 select-none font-display text-[7rem] font-bold leading-none opacity-10"
                  style="color: var(--color-signal);"
                  aria-hidden="true"
                >
                  {p.serial}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-faint">{p.serial} / preview pending</span>
              </div>
            )}
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-display text-lg font-bold">{p.name}</h3>
                <span
                  class="border border-line px-2 py-1 font-mono text-[10px] font-bold tracking-[0.2em]"
                  style={`color: ${p.badgeColor};`}
                >
                  {p.badge}
                </span>
              </div>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{p.blurb}</p>
              <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
                {p.tags.map((t) => (
                  <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-faint">#{t}</span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Archive tier — live from GitHub + statics -->
    <h3 class="mt-10 font-mono text-[11px] uppercase tracking-[0.25em] text-muted">The archive</h3>
    <div class="mt-3">
      <Projects client:visible />
      <div class="mt-px grid gap-px">
        <div class="flex flex-wrap items-center justify-between gap-3 border border-line bg-card px-5 py-4">
          <div>
            <h4 class="font-display font-bold">Advanced Utility Discord Bot</h4>
            <p class="mt-1 text-sm text-muted">
              Serving one of the largest <span class="redact">[REDACTED]</span>-university Discord servers since 2021 —
              verification, recruiter queues, course records.
            </p>
            <div class="mt-2 flex gap-x-3">
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-faint">#discord.js</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-faint">#mongodb</span>
            </div>
          </div>
          <span class="border border-line px-2 py-1 font-mono text-[10px] font-bold tracking-[0.2em] text-muted">ACTIVE</span>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border border-line bg-card px-5 py-4">
          <div>
            <h4 class="font-display font-bold">adept.dev — Mark 1</h4>
            <p class="mt-1 text-sm text-muted">The previous incarnation of this site: Next.js 14, NextAuth, Vercel. Retired by Mark 2 — the one you're reading.</p>
            <div class="mt-2 flex gap-x-3">
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-faint">#nextjs</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-faint">#vercel</span>
            </div>
          </div>
          <span class="border border-line px-2 py-1 font-mono text-[10px] font-bold tracking-[0.2em] text-faint">ARCHIVED</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4.0 CONTACT -->
  <section id="contact" class="mx-auto max-w-5xl scroll-mt-24 pt-20">
    <SectionHead n="4.0" name="Contact" headline="Open a channel" />
    <p class="mt-6 max-w-xl leading-relaxed text-muted">
      Questions, collaborations, or just want to compare homelab notes — the inbox is open.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="mailto:hello@adeptproductions.dev"
        class="border border-ink bg-ink px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.2em] transition-colors hover:border-signal hover:bg-signal"
        style="color: var(--color-base);"
      >
        hello@adeptproductions.dev
      </a>
      <a
        href="https://github.com/AdeptOfficial"
        target="_blank"
        rel="noreferrer"
        class="border border-line px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted transition-colors hover:border-muted hover:text-ink"
      >
        GitHub // AdeptOfficial
      </a>
    </div>
  </section>
</Base>

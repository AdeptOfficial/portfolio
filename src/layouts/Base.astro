---
import { i18n } from '../lib/i18n';
const { t, localize, locale } = i18n(Astro.url);
import '../styles/global.css';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { englishPath, hasTranslation, prefix } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description = t('AdepT — software developer, founder of Adept Productions.') } = Astro.props;

const NAV = [
  { label: 'About', href: '/#about' },
  { label: 'Experience', href: '/#experience' },
  { label: 'System', href: '/#system' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Contact', href: '/#contact' },
];

// Baked at build time (astro.config.mjs). Mark 1 = the retired Next.js site.
// @ts-ignore — injected by vite define
const commit: string = __COMMIT__;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("fx");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1014" />
    <meta name="description" content={description} />
    {hasTranslation(Astro.url.pathname) && <>
      <link rel="alternate" hreflang="en" href={new URL(englishPath(Astro.url.pathname), Astro.site)} />
      <link rel="alternate" hreflang="zh-Hans" href={new URL(prefix + englishPath(Astro.url.pathname), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(englishPath(Astro.url.pathname), Astro.site)} />
    </>}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={localize("/favicon.png")} />
    <link rel="apple-touch-icon" href={localize("/apple-touch-icon.png")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>

    <!-- Open Graph / social cards -->
    <meta property="og:site_name" content="AdepT" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-50 border-b border-line bg-base/90 backdrop-blur">
      <div class="flex h-16 w-full items-center justify-between gap-3 px-4 sm:px-8 lg:px-14">
        <a href={localize("/")} class="flex shrink-0 items-center gap-3">
          <img src="/logo.png" alt="" class="size-7" aria-hidden="true" />
          <span class="font-display text-sm font-bold uppercase tracking-[0.3em]">AdepT</span>
        </a>
        <div class="ml-auto flex items-center gap-3 lg:gap-6">
        <nav class="flex items-center gap-4 lg:gap-6" aria-label={t("Main")}>
          {
            NAV.map((item) => (
              <a
                href={localize(item.href)}
                class="hidden font-mono text-[11px] uppercase tracking-[0.2em] text-muted transition-colors hover:text-ink lg:inline"
              >
                {t(item.label)}
              </a>
            ))
          }
          <a
            href="mailto:hello@adeptproductions.dev?subject=Resume%20request"
            class="border border-line px-3 py-2 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-muted transition-colors hover:border-signal hover:text-ink"
          > {t("Request dossier")} </a>
        </nav>
        <LanguageSwitch />
        </div>
      </div>
    </header>

    <main class="w-full flex-1 px-4 sm:px-8 lg:px-14">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line">
      <div class="flex w-full flex-col gap-4 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-14 xl:px-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-faint">
          © {new Date().getFullYear()} AdepT // {t("Designed & built from scratch, self-hosted on my own hardware")}
        </p>
        <div class="flex items-center justify-between gap-5"><p class="flex gap-5 font-mono text-[11px] uppercase tracking-[0.15em]">
          <a href={localize("https://adeptproductions.dev")} class="text-faint hover:text-ink">{t("Studio")}</a>
          <span class="text-faint">Mark 2 #{commit}</span>
        </p><LanguageSwitch /></div>
      </div>
    </footer>

    <script>
      // ── Section FX engine ──────────────────────────────────────────
      // Sections get .in-view on first entry (CSS handles rv-* motion);
      // [data-decode] text scrambles into place, [data-type] prompts
      // type out. Without JS or with reduced-motion, full text just shows.
      const GLYPHS = '!<>-_\\/[]{}=+*^?#░▒▓01';
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function decode(el: HTMLElement) {
        const text = el.textContent ?? '';
        const total = Math.max(24, text.length * 2.2);
        let frame = 0;
        const tick = () => {
          frame++;
          const resolved = Math.floor((frame / total) * text.length);
          let out = '';
          for (let i = 0; i < text.length; i++) {
            if (text[i] === ' ' || i < resolved) out += text[i];
            else out += GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
          }
          el.textContent = out;
          if (frame < total) requestAnimationFrame(tick);
          else el.textContent = text;
        };
        tick();
      }

      function typeOut(el: HTMLElement) {
        const text = el.getAttribute('data-type') ?? '';
        let i = 0;
        el.textContent = '';
        const iv = setInterval(() => {
          el.textContent = text.slice(0, ++i);
          if (i >= text.length) clearInterval(iv);
        }, 26);
      }

      const sections = document.querySelectorAll('main section');
      const fxEls = document.querySelectorAll('.rv, .rv-left, .rv-scale, .rv-blur');

      if ('IntersectionObserver' in window && !reduced) {
        // Motion fires per-element as it scrolls into view — tall sections
        // cascade with the scroll instead of playing offscreen.
        const fxIO = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                fxIO.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        fxEls.forEach((el) => fxIO.observe(el));

        // Decode/typewriter fire once per section entry.
        const textIO = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.querySelectorAll<HTMLElement>('[data-decode]').forEach(decode);
                e.target.querySelectorAll<HTMLElement>('[data-type]').forEach(typeOut);
                textIO.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        sections.forEach((s) => textIO.observe(s));
      } else {
        fxEls.forEach((el) => el.classList.add('in-view'));
      }
    </script>
  </body>
</html>

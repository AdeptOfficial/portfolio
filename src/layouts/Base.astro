---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AdepT — software developer, founder of Adept Productions.' } = Astro.props;

const NAV = [
  { label: 'About', href: '/#about' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Contact', href: '/#contact' },
];

// Baked at build time (astro.config.mjs). Mark 1 = the retired Next.js site.
// @ts-ignore — injected by vite define
const commit: string = __COMMIT__;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1014" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-50 border-b border-line bg-base/90 backdrop-blur">
      <div class="flex h-16 w-full items-center justify-between gap-3 px-4 sm:px-8 lg:px-14">
        <a href="/" class="flex shrink-0 items-center gap-3">
          <span class="block size-2.5" style="background: var(--color-signal);" aria-hidden="true"></span>
          <span class="font-display text-sm font-bold uppercase tracking-[0.3em]">AdepT</span>
        </a>
        <nav class="flex items-center gap-4 sm:gap-6" aria-label="Main">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class="hidden font-mono text-[11px] uppercase tracking-[0.2em] text-muted transition-colors hover:text-ink sm:inline"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="mailto:hello@adeptproductions.dev?subject=Resume%20request"
            class="border border-line px-3 py-2 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-muted transition-colors hover:border-signal hover:text-ink"
          >
            Request dossier
          </a>
        </nav>
      </div>
    </header>

    <main class="w-full flex-1 px-4 sm:px-8 lg:px-14">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line">
      <div class="flex w-full flex-col gap-3 px-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-14">
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-faint">
          © {new Date().getFullYear()} AdepT // Designed &amp; built from scratch, self-hosted on my own hardware
        </p>
        <p class="flex gap-5 font-mono text-[11px] uppercase tracking-[0.15em]">
          <a href="https://adeptproductions.dev" class="text-faint hover:text-ink">Studio</a>
          <a
            href={`https://github.com/AdeptOfficial/adept.dev/commit/${commit}`}
            class="text-faint hover:text-ink"
            title="This exact build's commit"
          >
            Mark 2 #{commit}
          </a>
        </p>
      </div>
    </footer>

    <script>
      // Section entrance reveals; everything stays visible if JS/IO is unavailable.
      const sections = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        sections.forEach((s) => io.observe(s));
      } else {
        sections.forEach((s) => s.classList.add('in-view'));
      }
    </script>
  </body>
</html>

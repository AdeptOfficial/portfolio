---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AdepT — computer science student, builder of small focused software.' } = Astro.props;

const NAV = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Contact', href: '/contact/' },
  // Studio site — swap for the real domain once purchased.
  { label: 'Studio', href: 'https://adeptproductions.dev' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1014" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-50 border-b border-line bg-base/90 backdrop-blur">
      <div class="flex h-16 w-full items-center justify-between px-4 sm:px-8 lg:px-14">
        <a href="/" class="flex items-center gap-3">
          <span class="block size-2.5" style="background: var(--color-signal);" aria-hidden="true"></span>
          <span class="font-display text-sm font-bold uppercase tracking-[0.3em]">adept.dev</span>
        </a>
        <nav class="flex items-center gap-6" aria-label="Main">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="w-full flex-1 px-4 sm:px-8 lg:px-14">
      <slot />
    </main>

    <footer class="mt-20 border-t border-line">
      <div class="flex w-full flex-col gap-3 px-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-14">
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-faint">
          © {new Date().getFullYear()} AdepT // adept.dev
        </p>
        <a href="/admin" class="font-mono text-[11px] uppercase tracking-[0.15em] text-faint hover:text-muted">Admin</a>
      </div>
    </footer>
  </body>
</html>
